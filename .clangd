CompileFlags:
  Add:
    # Generated TableGen headers live in the build tree.
    - -I/home/senuser/dt-inductor/dataflow-scheduler/build/include
    - -I/home/senuser/dt-inductor/dataflow-scheduler/build/external/dataflow-scheduler-dialects/include
    - -I/home/senuser/dt-inductor/dataflow-scheduler/build/external/ktir-mlir-frontend/include
  Remove:
    # LLVM's CMake emits a malformed -D flag where the macro value contains
    # extra -D flags due to quoting; strip it and re-add the correct form.
    - -D_GLIBCXX_USE_CXX11_ABI=*
    # ccache wrapper can confuse clangd — it sees the real compiler anyway
    # via the compile_commands compiler path; nothing to remove here.
